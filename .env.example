# Get a free key at https://console.groq.com/keys
# This is what actually gives you access to Llama 3.3 70B for the gap-analysis narratives.
GROQ_API_KEY= 
GROQ_MODEL=llama-3.3-70b-versatile

# Sentence-Transformers model used for embeddings + cosine similarity scoring
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cosine similarity thresholds that decide Covered / Partial / Gap
COVERAGE_THRESHOLD=0.62
PARTIAL_THRESHOLD=0.45
